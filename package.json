    "indexes:check": "node scripts/wiki-maintenance.mjs indexes",
    "indexes:sync": "node scripts/wiki-maintenance.mjs indexes --apply",
    "ingest": "node scripts/ingest.mjs",
    "ingest:monsters": "node scripts/ingest-monsters.mjs",
    "ingest:monster-appendices": "node scripts/ingest-monster-appendices.mjs",
    "organize:monsters": "node scripts/organize-monster-wiki.mjs",
    "organize:missing-indexes": "node scripts/create-missing-indexes.mjs",
